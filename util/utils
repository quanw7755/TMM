def _tta_transform(
    images,
    transform_name
):
    """
    Apply a deterministic geometric TTA transformation.

    Parameters
    ----------
    images:
        [B,C,H,W]

    transform_name:
        identity
        hflip
        vflip
        hvflip
        rot90
        rot180
        rot270
    """

    if transform_name == "identity":

        return images

    elif transform_name == "hflip":

        return torch.flip(
            images,
            dims=[3]
        )

    elif transform_name == "vflip":

        return torch.flip(
            images,
            dims=[2]
        )

    elif transform_name == "hvflip":

        return torch.flip(
            images,
            dims=[2, 3]
        )

    elif transform_name == "rot90":

        return torch.rot90(
            images,
            k=1,
            dims=[2, 3]
        )

    elif transform_name == "rot180":

        return torch.rot90(
            images,
            k=2,
            dims=[2, 3]
        )

    elif transform_name == "rot270":

        return torch.rot90(
            images,
            k=3,
            dims=[2, 3]
        )

    else:

        raise ValueError(
            f"Unknown TTA transform: "
            f"{transform_name}"
        )


def _tta_inverse_map(
    anomaly_map,
    transform_name
):
    """
    Invert a geometric TTA transformation on anomaly maps.

    anomaly_map:
        [B,1,H,W]

    IMPORTANT:
        Prediction maps must be mapped back to the original
        image coordinate system BEFORE TTA fusion.
    """

    if transform_name == "identity":

        return anomaly_map

    elif transform_name == "hflip":

        return torch.flip(
            anomaly_map,
            dims=[3]
        )

    elif transform_name == "vflip":

        return torch.flip(
            anomaly_map,
            dims=[2]
        )

    elif transform_name == "hvflip":

        return torch.flip(
            anomaly_map,
            dims=[2, 3]
        )

    elif transform_name == "rot90":

        # Forward:
        #     +90 degree
        #
        # Inverse:
        #     -90 degree = +270 degree
        return torch.rot90(
            anomaly_map,
            k=3,
            dims=[2, 3]
        )

    elif transform_name == "rot180":

        return torch.rot90(
            anomaly_map,
            k=2,
            dims=[2, 3]
        )

    elif transform_name == "rot270":

        # Forward:
        #     +270 degree
        #
        # Inverse:
        #     +90 degree
        return torch.rot90(
            anomaly_map,
            k=1,
            dims=[2, 3]
        )

    else:

        raise ValueError(
            f"Unknown TTA transform: "
            f"{transform_name}"
        )


def _get_tta_transforms(
    tta_mode
):
    """
    Return TTA transformation list.

    Recommended first experiment:
        hflip

    Stronger modes are provided only for ablation.
    """

    if tta_mode == "none":

        return [
            "identity"
        ]

    elif tta_mode == "hflip":

        return [
            "identity",
            "hflip"
        ]

    elif tta_mode == "flip4":

        return [
            "identity",
            "hflip",
            "vflip",
            "hvflip"
        ]

    elif tta_mode == "rot4":

        return [
            "identity",
            "rot90",
            "rot180",
            "rot270"
        ]

    else:

        raise ValueError(
            f"Unsupported tta_mode={tta_mode}"
        )


@torch.no_grad()
def detect_forward_tta(
    clip_model,
    images,
    args
):
    """
    Test-Time Augmented inference.

    Image-level prediction:
        weighted average over transformed views.

    Pixel-level prediction:
        1. predict transformed image;
        2. inverse-transform anomaly map;
        3. weighted average in original coordinates.

    The model itself remains unchanged.
    """

    tta_mode = getattr(
        args,
        "tta_mode",
        "none"
    )
    # ========================================================
    # Signed / Safe Fusion configuration
    # ========================================================

    use_signed_fusion = bool(
        getattr(
            args,
            "use_signed_fusion",
            0
        )
    )

    use_safe_fusion = bool(
        getattr(
            args,
            "use_safe_fusion",
            0
        )
    )
    transforms_list = _get_tta_transforms(
        tta_mode
    )

    # ========================================================
    # No TTA
    # ========================================================

    if len(transforms_list) == 1:

        return clip_model.detect_forward(
            images,
            args
        )

    # ========================================================
    # Identity-heavy conservative fusion
    #
    # For example:
    #
    # hflip:
    #     0.5 identity
    #     0.5 hflip
    #
    # flip4:
    #     0.5 identity
    #     remaining 0.5 shared by three augmentations
    # ========================================================

    identity_weight = float(
        getattr(
            args,
            "tta_identity_weight",
            0.5
        )
    )

    identity_weight = max(
        0.0,
        min(
            1.0,
            identity_weight
        )
    )

    num_augmented = (
        len(transforms_list)
        -
        1
    )

    if num_augmented > 0:

        augmented_weight = (
            1.0
            -
            identity_weight
        ) / num_augmented

    else:

        augmented_weight = 0.0

    cls_fused = None
    map_fused = None

    # ========================================================
    # TTA inference
    # ========================================================

    for transform_name in transforms_list:

        # ----------------------------------------------------
        # Transform input
        # ----------------------------------------------------

        images_tta = _tta_transform(
            images,
            transform_name
        )

        # ----------------------------------------------------
        # Run complete AF-CLIP + World model
        # ----------------------------------------------------

        cls_score_tta, anomaly_map_tta = (
            clip_model.detect_forward(
                images_tta,
                args
            )
        )

        # ----------------------------------------------------
        # Restore anomaly map to original coordinates
        # ----------------------------------------------------

        anomaly_map_tta = _tta_inverse_map(
            anomaly_map_tta,
            transform_name
        )

        # ----------------------------------------------------
        # Fusion weight
        # ----------------------------------------------------

        if transform_name == "identity":

            weight = identity_weight

        else:

            weight = augmented_weight

        # ----------------------------------------------------
        # Image score fusion
        # ----------------------------------------------------

        if cls_fused is None:

            cls_fused = (
                weight
                *
                cls_score_tta.float()
            )

        else:

            cls_fused = (
                cls_fused
                +
                weight
                *
                cls_score_tta.float()
            )

        # ----------------------------------------------------
        # Pixel map fusion
        # ----------------------------------------------------

        if map_fused is None:

            map_fused = (
                weight
                *
                anomaly_map_tta.float()
            )

        else:

            map_fused = (
                map_fused
                +
                weight
                *
                anomaly_map_tta.float()
            )

    return (
        cls_fused,
        map_fused
    )


