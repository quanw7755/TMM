import math

import torch
import torch.nn.functional as F
from torch import nn


# ============================================================
# 1. Center-free spatial context kernel
# ============================================================

def build_neighbor_kernel(kernel_size, sigma=None):
    """
    Build a Gaussian-like spatial context kernel.

    IMPORTANT:
    The center position is explicitly removed.

    Therefore the predictor cannot directly observe
    the target patch that it is required to predict.
    """

    if sigma is None:
        sigma = kernel_size / 2.0

    coord = torch.arange(
        kernel_size,
        dtype=torch.float32
    )

    coord = coord - (kernel_size - 1) / 2.0

    yy, xx = torch.meshgrid(
        coord,
        coord,
        indexing="ij"
    )

    kernel = torch.exp(
        -(xx ** 2 + yy ** 2)
        / (2.0 * sigma ** 2)
    )

    # --------------------------------------------------------
    # Remove center patch
    # --------------------------------------------------------
    center = kernel_size // 2
    kernel[center, center] = 0.0

    # --------------------------------------------------------
    # Normalize remaining context
    # --------------------------------------------------------
    kernel = kernel / kernel.sum().clamp_min(1e-6)

    return kernel


